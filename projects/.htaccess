# Folders under here are work in progress, so a folder without its own index
# still has to be browsable: that is how you reach a version subfolder that has
# no landing page of its own.
#
# The listing is rendered by dashboard/browse.php, which puts it inside the
# dashboard layout. Apache's own autoindex is off: it can be styled but not
# wrapped, because HeaderName and mod_autoindex disagree about who owns the
# markup, and the table quietly loses its class names as soon as a header file
# is involved.
Options -Indexes
DirectoryIndex index.php index.html index.htm /dashboard/browse.php

# The files that must never be served stay protected here too. Same rule as
# the root .htaccess and dashboard/browse.php: a compressed dump is still a
# dump, and the match ignores case.
<FilesMatch "(?i)(^\.|\.(env|sql|sqlite|sqlite3|sq3|db|db3|s3db|dump|pem|key|log|bak)(\.(gz|bz2|xz|zst|zip|7z|tar|tgz))?$|composer\.(json|lock)$)">
    Require all denied
</FilesMatch>
