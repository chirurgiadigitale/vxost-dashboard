#!/bin/bash
#
# Blocks a commit that is about to take local or private data into the repo.
# To enable:  git config core.hooksPath .githooks
#
# It checks three things:
#   1. names of the folders inside the projects directory (customer work)
#   2. private IP addresses, Listen directives, DocumentRoot with real paths
#   3. files that must never be versioned (dumps, keys, credentials)

set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
FAIL=0

if [ -z "$STAGED" ]; then
    exit 0
fi

red()  { printf '\033[31m%s\033[0m\n' "$1"; }
warn() { printf '\033[33m%s\033[0m\n' "$1"; }

# The folder that holds customer work.
PROJECTS_DIR=""
[ -d "$ROOT/projects" ] && PROJECTS_DIR="projects"

# ---------------------------------------------------------------------------
# 1. Names of the local projects
# ---------------------------------------------------------------------------
if [ -n "$PROJECTS_DIR" ]; then
    for dir in "$ROOT/$PROJECTS_DIR"/*/; do
        [ -d "$dir" ] || continue
        name=$(basename "$dir")
        # skip names that are too short or too generic: they would raise
        # false positives
        case "$name" in
            ?|??|???|????|public|src|app|web|test|v4|Theme) continue ;;
        esac
        # URLs pointing at public domains are not local paths: a project name
        # that happens to match a domain (an agency credit, for instance) must
        # not block the commit. The name counts as a path or a bare string.
        hits=$(git diff --cached -U0 \
            | grep '^+' | grep -v '^+++' \
            | sed -E 's#https?://[^"'"'"' )]+##g' \
            | grep -i -- "$name" || true)
        if [ -n "$hits" ]; then
            red "✗ The project name '$name' appears in the staged changes:"
            printf '%s\n' "$hits" | head -2 | cut -c1-100 | sed 's/^/    /'
            FAIL=1
        fi
    done
fi

# ---------------------------------------------------------------------------
# 2. Local configuration data
# ---------------------------------------------------------------------------
DIFF=$(git diff --cached -U0 | grep '^+' | grep -v '^+++' || true)

check_pattern() {
    local pattern="$1" label="$2"
    local found
    found=$(printf '%s\n' "$DIFF" | grep -E -- "$pattern" || true)
    if [ -n "$found" ]; then
        red "✗ $label found:"
        printf '%s\n' "$found" | head -3 | sed 's/^/    /'
        FAIL=1
    fi
}

check_pattern '\b192\.168\.[0-9]+\.[0-9]+' 'Local network IP address'
check_pattern '\b10\.[0-9]+\.[0-9]+\.[0-9]+' 'Private IP address'
check_pattern '\b172\.(1[6-9]|2[0-9]|3[01])\.[0-9]+\.[0-9]+' 'Private IP address'
check_pattern 'blowfish_secret[[:space:]]*=[[:space:]]*.[^\x27"]' 'phpMyAdmin secret'
check_pattern '(password|passwd|secret|api[_-]?key)[[:space:]]*=[[:space:]]*.[A-Za-z0-9]{6}' 'Possible credential'

# A DocumentRoot pointing at a real folder inside the projects directory
check_pattern 'DocumentRoot[[:space:]]+"?[^"]*htdocs/projects/[a-z0-9]' 'DocumentRoot of a real project'

# ---------------------------------------------------------------------------
# 3. Files that must never be versioned
# ---------------------------------------------------------------------------
for file in $STAGED; do
    case "$file" in
        projects/*)
            # These ship with the distribution, they are not customer work
            case "$file" in
                projects/index.php|projects/README.txt|projects/.htaccess) ;;
                *)
                    red "✗ File from the projects folder is staged: $file"
                    FAIL=1
                    ;;
            esac
            ;;
        *.sql|*.sqlite|*.sqlite3|*.db|*.dump|*credentials*|*.pem|*.key|.env|.env.*)
            red "✗ Sensitive file staged: $file"
            FAIL=1
            ;;
        */.DS_Store|.DS_Store)
            red "✗ .DS_Store staged: $file"
            FAIL=1
            ;;
    esac
done

if [ "$FAIL" -ne 0 ]; then
    echo
    warn "Commit stopped: remove the local data from the stage before going on."
    warn "To override deliberately:  git commit --no-verify"
    exit 1
fi

exit 0
