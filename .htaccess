# =============================================================================
#  VXOST Dashboard v2, configurazione della radice web
#  Funziona senza modificare httpd.conf: qui bastano i permessi utente.
# =============================================================================

# Pagina di errore della dashboard al posto di quella predefinita di Apache
ErrorDocument 404 /dashboard/404.html

# Non esporre l'elenco dei file delle cartelle senza indice: su una macchina di
# sviluppo il listing rivela i nomi di tutti i progetti in lavorazione.
Options -Indexes

# Nega l'accesso ai file di configurazione, ai dump e alle chiavi che possono
# trovarsi dentro le cartelle dei progetti.
<FilesMatch "(^\.|\.(env|sql|sqlite|sqlite3|db|dump|pem|key|log|bak)$|composer\.(json|lock)$)">
    Require all denied
</FilesMatch>

# La cartella con la cronologia di git non deve mai essere servita
RedirectMatch 404 /\.git

<IfModule mod_headers.c>
    # The content is local: no referrer leaves the machine
    Header set Referrer-Policy "no-referrer"
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# The projects folder was renamed from progetti to projects. Old bookmarks and
# links keep working through this redirect rather than landing on a 404.
# 301 rather than 302: the move is permanent, and browsers should learn it.
RedirectMatch 301 ^/progetti(/.*)?$ /projects$1
